# Dari Supabase Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Password untuk login ke /admin
ADMIN_PASSWORD=

# String acak panjang untuk menandatangani session admin (mis. hasil `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# URL publik situs (tanpa trailing slash) — dipakai untuk SEO: metadata,
# Open Graph, canonical, sitemap, robots. Contoh: https://namakamu.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API key dari resend.com (Dashboard > API Keys) — buat kirim email dari form kontak.
RESEND_API_KEY=

# Alamat pengirim email form kontak. Tanpa domain terverifikasi di Resend,
# pakai default "onboarding@resend.dev". Kalau sudah verifikasi domain sendiri
# di Resend, ganti jadi mis. kontak@namakamu.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Gemini API Key (Dimas Lab Experiment 01)
GEMINI_API_KEY=
